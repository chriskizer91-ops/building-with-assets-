    "aether": { "repo": "chriskizer91-ops/20-min", "paths": ["/dist/*.html"] },
    "aethermoor": { "repo": "chriskizer91-ops/New-game", "paths": ["/*.html"] },
    "envoi": { "repo": "chriskizer91-ops/envoi-on-the-longest-night", "build": ["node", "tools/build.mjs"] }
  },
